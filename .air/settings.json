{
    "toolchains": [
        {
            "name": "Go Docker",
            "type": "docker",
            "docker": {
                "image": "golang:1.21-alpine",
                "workingDirectory": "/workspace",
                "volumes": [
                    {
                        "hostPath": ".",
                        "containerPath": "/workspace"
                    }
                ],
                "environment": {
                    "CGO_ENABLED": "0",
                    "GOOS": "linux"
                },
                "network": "host"
            },
            "go": {
                "version": "1.21",
                "goroot": "/usr/local/go",
                "gopath": "/go"
            }
        }
    ]
}