# VendOCI Configuration Example
# Copy this file to .vendoci.yaml and customize for your environment

# Target registry where images will be vendored
target_registry: "myregistry.example.com"

# Prefix for vendored images (default: "vendor")
vendor_prefix: "vendor"

# Authentication for the target registry
auth:
  username: "your-username"
  # Instead of hardcoding password, use environment variable
  password_env: "VENDOCI_PASSWORD"
  # Alternative: use token authentication
  # token_env: "VENDOCI_TOKEN"

# Images organized by groups (recommended)
groups:
  base-images:
    images:
      - source: "docker.io/ubuntu"
        tags:
          - "latest"
          - "20.04"
          - "22.04"

      - source: "docker.io/alpine"
        tags:
          - "latest"
          - "3.19"

  web-servers:
    images:
      - source: "docker.io/nginx"
        tags:
          - "latest"
          - "alpine"
          - "1.25"

  databases:
    images:
      - source: "docker.io/postgres"
        tags:
          - "15"
          - "16"

      - source: "docker.io/redis"
        tags:
          - "latest"
          - "7-alpine"
        # Optional: Override the default target name transformation
        target_override: "redis-cache"

  monitoring:
    images:
      - source: "quay.io/prometheus/prometheus"
        tags:
          - "latest"
          - "v2.45.0"

# Legacy format (still supported but groups are recommended)
# images:
#   - source: "docker.io/ubuntu"
#     tags:
#       - "latest"

# Results will be:
# docker.io/ubuntu:latest -> myregistry.example.com/vendor/docker.io/ubuntu:latest
# docker.io/nginx:alpine -> myregistry.example.com/vendor/docker.io/nginx:alpine
# docker.io/redis:latest -> myregistry.example.com/vendor/redis-cache:latest
# quay.io/prometheus/prometheus:latest -> myregistry.example.com/vendor/quay.io/prometheus/prometheus:latest